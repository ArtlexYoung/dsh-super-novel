{
  "name": "dsh-super-novel",
  "version": "0.0.9",
  "description": "Local novel writing with chapter candidates and author-approved changes for DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preset": {
      "types": "./lib/preset/index.d.ts",
      "default": "./lib/preset/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    }
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "docs/README.md",
    "docs/usage.md",
    "docs/development.md",
    "docs/architecture.md",
    "docs/evaluation.md",
    "docs/P0-VALIDATION.md",
    "docs/LIVE-EVAL-P0.md",
    "docs/BROWSER-WRITING-P0.md",
    "docs/RELEASE-0.0.1.md",
    "docs/screenshots"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json --noEmit",
    "build": "tsc -p tsconfig.host.json && node --experimental-strip-types scripts/build.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "dev:link-harness": "node --experimental-strip-types scripts/link-harness.ts",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.1.5-rc.2",
    "@types/node": "^22.20.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "novel",
    "writing",
    "generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtlexYoung/dsh-super-novel.git"
  },
  "homepage": "https://github.com/ArtlexYoung/dsh-super-novel#readme",
  "bugs": {
    "url": "https://github.com/ArtlexYoung/dsh-super-novel/issues"
  }
}
